{
  "group_name": "example",
  "project": "house_price",
  "version": "1",
  "feature_selection": {
        "top_feautures_to_select": 5,
        "count_category": 100,
        "cutoff_1_category":  0.95,
        "cutoff_nan": 0.7,
        "max_corr_value":0.8,
        "metric_eval":  {"price": "neg_mean_absolute_error"},
        "cv_diff_value":  0.1,
        "encoding_cat":  "WoE_cat_to_num",
        "encoding_num":  "cut_num",
        "default_cat":  "_NAN_",
        "default_num": "_MEDIAN_",
        "params": {"iterations": 100},
        "features_to_ignore":  ["general"],
        "use_temp_data": false
  },

  "hp_tune": {"metric_score": {"price": "neg_mean_absolute_error"}},
  "inference_criteria": {"prod_models_folder": "models",
                               "metric_growth_value": {"CompareBusinessMetric":  0.001},
                                "threshold":  [0.6, 0.8],
                                "calculate_threshold": 0,
                                "prod_path": null},

  "mlflow_experiment": "HousePriceExample",
  "grafana_table_name": "HousePriceExample",
  "dashboard_name": "HousePriceExample",
  "trigger": {"table_name":  "public.'HousePriceExample'", "field":  "PASSENGERID"}
}

